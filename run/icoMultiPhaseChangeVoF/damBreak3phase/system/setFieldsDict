FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultValues
{
    alpha.air       1;
    alpha.water     0;
    alpha.oil       0;
}

zones
{
    water
    {
        type        box;

        box         (0 0 -1) (0.1461 0.2 1);

        values
        {
            alpha.water     1;
            alpha.oil       0;
            alpha.air       0;
        }
    }

    oil
    {
        type        box;

        box         (0.1461 0 -1) (0.2922 0.2 1);

        values
        {
            alpha.water     0;
            alpha.oil       1;
            alpha.air       0;
        }
    }
}

