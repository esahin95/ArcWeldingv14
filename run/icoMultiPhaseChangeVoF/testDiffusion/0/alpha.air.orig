FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      alpha.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [];

internalField   uniform 1;

boundaryField
{
    "(right|left|bottom)"
    {
        type            alphaContactAngle;
        contactAngleProperties
        {
            air             { theta0 90; }
            oil             { theta0 90; }
        }
        value           uniform 0;
    }

    top
    {
        type            inletOutlet;
        inletValue      uniform 1;
        value           uniform 1;
    }

    "(front|back)"
    {
        type            empty;
    }
}


// ************************************************************************* //