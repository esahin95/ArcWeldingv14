     \\/     M anipulation  |
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      alpha.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [];

internalField
{
    type        zonal;

    defaultValue    0;

    zones
    {
        water
        {
            type            box;

            box             (-1 -1 -1) (0.0005 0.0002 1);

            value           1;
        }

        oil
        {
            type            box;

            box             (0.0005 -1 -1) (1 0.0002 1);

            value           0;
        }
    }
}

boundaryField
{
    "(right|left|bottom)"
    {
        type            alphaContactAngle;
        contactAngleProperties
        {
            air             { theta0 90; }
            oil             { theta0 90; }
        }
        value           uniform 0;
    }

    top
    {
        type            inletOutlet;
        inletValue      uniform 0;
        value           uniform 0;
    }

    "(front|back)"
    {
        type            empty;
    }
}


// ************************************************************************* //