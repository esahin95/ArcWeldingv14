FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [temperature];

internalField   uniform 293;

boundaryField
{
    "(left|right|bottom)"
    {
        type            fixedValue;
        value           $internalField;
    }

    top
    {
        type            inletOutlet;
        phi             rhoPhi;
        inletValue      $internalField;
    }

    "(front|back)"
    {
        type            empty;
    }
}


