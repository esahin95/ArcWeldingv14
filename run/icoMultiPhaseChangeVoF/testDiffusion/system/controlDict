FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          icoMultiPhaseChangeVoF;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.001;

deltaT          1e-6;

writeControl    adjustableRunTime;

writeInterval   0.0001;

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.5;
maxAlphaCo      0.5;
maxEnCo       10000;
maxDiCo           1;

maxDeltaT       1e-4;


// ************************************************************************* //

DebugSwitches
{
    MULES 1;
}

OptimisationSwitches
{
    fileHandler collated;
}

functions
{
    #includeFunc lineUniform
}