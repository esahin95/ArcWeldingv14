FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [temperature];

T0 800;
internalField   uniform $T0;

boundaryField
{
    "(top|bottom|left|right)"
    {
        type            zeroGradient;
    }

    "(front|back)"
    {
        type            empty;
    }
}


