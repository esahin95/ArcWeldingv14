FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      alpha.bismuth;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [];

internalField   uniform 1;

boundaryField
{
    "(right|left|bottom|top)"
    {
        //type            zeroGradient;
        type            fixedValue;
        value           $internalField;
    }

    /*
    top
    {
        type            inletOutlet;
        value           $internalField;
        inletValue      $internalField;
    }
    */

    "(front|back)"
    {
        type            empty;
    }
}


// ************************************************************************* //