FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [temperature];

internalField
{
    type        coded;

    evaluate
    #{
        const scalar lx = 0.001;
        const scalar dT = 4.0;
        const scalar T0 = 300.0;

        const scalarField x(C.component(vector::X));

        field.primitiveFieldRef() = T0 + (0.5*lx - x)/lx*dT;
    #};
}

boundaryField
{
    "(top|bottom)"
    {
        type            zeroGradient;
    }

    right
    {
        type            fixedValue;
        value           uniform 298;
    }
    
    left
    {
        type            fixedValue;
        value           uniform 302;
    }

    "(front|back)"
    {
        type            empty;
    }
}


