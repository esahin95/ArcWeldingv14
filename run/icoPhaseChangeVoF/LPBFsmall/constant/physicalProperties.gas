FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight   40; // Argon
    }

    equationOfState
    {
        rho         1.0;
    }

    thermodynamics
    {
        Cp          520;
        hf          0;
    }

    transport
    {
        mu          1.48e-05; // nu = 1.48e-5
        kappa       0.04;
    }
}


// ************************************************************************* //

