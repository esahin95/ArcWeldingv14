FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      refineMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

coordinates
{
    type        global;

    e1          (1 0 0);
    e2          (0 1 0);
    e3          (0 0 1);

    directions  (e1 e2 e3);
}

zones
{
    powderBed
    {
        type    spheres;
        data
        (
            #include "powderBed"
        );
        offset      (0 0 100e-6);
        scale       1.4;
    }
}

useHexTopology  true;

geometricCut    false;

