FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solver          icoPhaseChangeVoF;

startFrom       startTime;

startTime       0;

stopAt          nextWrite;

endTime         100e-6;

deltaT          1e-8;

writeControl    timeStep;//adjustableRunTime;

writeInterval   5;//1e-6;

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.2;
maxAlphaCo      0.2;
maxDiCo         500.0;

maxDeltaT       1e-6;

