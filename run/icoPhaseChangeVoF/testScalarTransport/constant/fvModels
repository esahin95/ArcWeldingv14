FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvModels;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

boussinesq
{
    type    BoussinesqForce;

    phase   water;

    beta    2e-2;

    T0      300;
}

boussinesqGas
{
    type    BoussinesqForce;

    phase   air;

    beta    0;

    T0      300;
}

