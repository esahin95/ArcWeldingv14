FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultValues
{
    alpha.water 0;
    T 300;
    heat.water 0;
}

zones
{
    water
    {
        type        box;

        box         (0 0 -1) (1 15e-3 1);

        values
        {
            alpha.water 1;
        }
    }

    bubble
    {
        type        sphere;

        centre  (5e-3 12e-3 5e-3);

        radius  2e-3;

        values
        {
            T   350;
            heat.water 1;
        }
    }
}

